# Development placeholders only. Replace the password locally; never commit .env.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_USER=novel_os
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=novel_os_dev
LOG_LEVEL=INFO

# Must use a separate database whose name ends in _test.
# URL-encode special characters in credentials in this URL.
TEST_DATABASE_URL=postgresql+psycopg://novel_os:change-me-local-only@127.0.0.1:55433/novel_os_test
